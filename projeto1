import tkinter as tk

usuarios= {} 

janela = tk.Tk()
janela.title("Cadastro de Usuários")
janela.geometry("300x220")

def cadastrar_usuario():
    usuario = entrada_usuario.get()
    senha = entrada_senha.get()

    if usuario == "" or senha == "":
        resultado.config(text="Preencha todos os campos!", fg="red")
    
    elif usuario in usuarios:
        resultado.config(text="Usuário já está cadastrado!", fg="red")
    
    else:
        usuarios[usuario] = senha
        resultado.config(text="Usuário cadastrado com sucesso!", fg="green")

